-- Shared fixtures for pgTAP tests. Included with \ir from each test file,
-- inside that file's transaction, so everything here is rolled back.

-- Start every test file from empty app tables (rolled back with the file), so
-- local data from manual testing never leaks in.
alter table public.activity_log disable trigger activity_log_no_truncate;
truncate public.activity_log, public.flag_dismissals, public.draw_snapshot_entries,
         public.draw_snapshots, public.winners, public.eligibility_overrides,
         public.entries, public.raffles, private.request_log;
alter table public.activity_log enable trigger activity_log_no_truncate;

create schema tests;
grant usage on schema tests to anon, authenticated;

create function tests.admin_id() returns uuid language sql immutable
as $$ select '00000000-0000-0000-0000-00000000a0a0'::uuid $$;

create function tests.other_id() returns uuid language sql immutable
as $$ select '00000000-0000-0000-0000-00000000b0b0'::uuid $$;

insert into auth.users (id, email, aud, role)
values (tests.admin_id(), 'pgtap-admin@tests.invalid', 'authenticated', 'authenticated'),
       (tests.other_id(), 'pgtap-other@tests.invalid', 'authenticated', 'authenticated');

insert into private.admins (user_id) values (tests.admin_id()) on conflict do nothing;

-- Named ids, so test SQL inside $$ strings can refer to fixtures.
create table tests.ids (name text primary key, id uuid not null);
grant select, insert, update on tests.ids to anon, authenticated;
create function tests.remember(p_name text, p_id uuid) returns uuid language sql as $$
  insert into tests.ids values (p_name, p_id)
  on conflict (name) do update set id = excluded.id
  returning id
$$;
create function tests.id(p_name text) returns uuid language sql stable as $$
  select id from tests.ids where name = p_name
$$;

-- Role switching. Each sets the JWT claims PostgREST would set, then the role.
create function tests.as_admin() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.admin_id(), 'role', 'authenticated')::text, true);
  set local role authenticated;
end $$;

create function tests.as_other_user() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.other_id(), 'role', 'authenticated')::text, true);
  set local role authenticated;
end $$;

create function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  set local role anon;
end $$;

create function tests.as_postgres() returns void language plpgsql as $$
begin
  reset role;
  perform set_config('request.jwt.claims', '', true);
end $$;

grant execute on all functions in schema tests to anon, authenticated;

-- Fixture builders (run as postgres; they bypass the admin RPCs on purpose).
create function tests.make_raffle(
  p_title text default 'Titans vs Colts',
  p_close_time timestamptz default now() - interval '1 minute',
  p_winner_count int default 1,
  p_exclusion_enabled boolean default true,
  p_exclusion_months int default 12,
  p_state public.raffle_state default 'open',
  p_created_at timestamptz default now() - interval '7 days'
) returns uuid language sql as $$
  insert into public.raffles (title, prize, details, close_time, winner_count,
                              exclusion_enabled, exclusion_months, state, created_at,
                              drawn_at, cancelled_at, cancel_reason)
  values (p_title, 'Two tickets', 'Section 101', p_close_time, p_winner_count,
          p_exclusion_enabled, p_exclusion_months, p_state, p_created_at,
          case when p_state = 'drawn' then p_close_time end,
          case when p_state = 'cancelled' then p_close_time end,
          case when p_state = 'cancelled' then 'fixture' end)
  returning id
$$;

create function tests.make_entry(
  p_raffle_id uuid,
  p_full_name text,
  p_email text,
  p_device_id text default null,
  p_removed boolean default false
) returns uuid language sql as $$
  insert into public.entries (raffle_id, full_name, email, device_id, removed_at, removed_reason)
  values (p_raffle_id, p_full_name, p_email, p_device_id,
          case when p_removed then now() end,
          case when p_removed then 'test removal' end)
  returning id
$$;

create function tests.make_past_winner(
  p_full_name text,
  p_email text,
  p_won_at timestamptz
) returns uuid language sql as $$
  insert into public.winners (source, full_name, email, won_at, note)
  values ('past', p_full_name, p_email, p_won_at, 'fixture')
  returning id
$$;

grant execute on all functions in schema tests to anon, authenticated;
