# Copy to .env.local for local development. Never commit real values.
# Only the publishable (anon) key belongs here - never a secret/service-role key.
#
# Defaults below point at a local Supabase stack: run `supabase start`, then
# `supabase status` prints the API URL and the publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `supabase status`>
